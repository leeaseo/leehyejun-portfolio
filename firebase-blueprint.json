{
  "entities": {
    "WorkProject": {
      "title": "WorkProject",
      "description": "Portfolio work project item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "date": { "type": "string" },
        "thumbnail": { "type": "string" },
        "images": { "type": "array" },
        "materials": { "type": "string" },
        "dimensions": { "type": "string" },
        "externalUrl": { "type": "string" },
        "order": { "type": "number" },
        "content": { "type": "string" }
      },
      "required": ["title", "slug"]
    },
    "AboutContent": {
      "title": "AboutContent",
      "description": "About section profile data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "location": { "type": "string" },
        "bio": { "type": "string" },
        "profileImage": { "type": "string" },
        "contact": { "type": "object" }
      },
      "required": ["name", "role"]
    },
    "ResumeContent": {
      "title": "ResumeContent",
      "description": "Resume section experience and education data",
      "type": "object",
      "properties": {
        "education": { "type": "array" },
        "experience": { "type": "array" },
        "skills": { "type": "array" },
        "honors": { "type": "array" },
        "certifications": { "type": "array" },
        "resumePdf": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "WorkProject",
      "description": "Collection of published portfolio projects"
    },
    "/site_content/{contentId}": {
      "schema": "AboutContent",
      "description": "General site content including about and resume documents"
    }
  }
}
