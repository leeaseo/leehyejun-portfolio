rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    match /site_content/{contentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
